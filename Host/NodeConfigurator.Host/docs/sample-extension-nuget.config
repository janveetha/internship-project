<?xml version="1.0" encoding="utf-8"?>
<!--
  Sample nuget.config for extension teams building plugins in their own solution.
  Place this file at the root of your extension solution.

  This configures NuGet to look for NodeConfigurator.Abstractions in:
  1. Your local development feed (for testing with local builds)
  2. Your organization's private feed (for released versions)
  3. nuget.org (for all other packages)
-->
<configuration>
  <packageSources>
	<clear />
	<!-- Local folder feed for development/testing -->
	<add key="LocalFeed" value="C:\LocalNuGetFeed" />

	<!-- Your organization's private NuGet feed (Azure Artifacts, GitHub Packages, etc.) -->
	<!-- <add key="OrgFeed" value="https://pkgs.dev.azure.com/your-org/_packaging/your-feed/nuget/v3/index.json" /> -->

	<!-- Public NuGet.org for other dependencies -->
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Optional: require specific packages to come from specific feeds -->
  <packageSourceMapping>
	<packageSource key="LocalFeed">
	  <package pattern="NodeConfigurator.*" />
	</packageSource>
	<packageSource key="nuget.org">
	  <package pattern="*" />
	</packageSource>
  </packageSourceMapping>
</configuration>
