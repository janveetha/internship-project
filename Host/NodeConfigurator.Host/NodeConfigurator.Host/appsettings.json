{
  // Plugin discovery configuration.
  // BOTH sources below are honored and merged. When the same plugin id is found more
  // than once, the HIGHEST "version" wins; on an exact-version tie an explicit "Paths"
  // entry wins over a discovered one. Folders reached by both sources load only once.
  "Plugins": {
    // 1) Explicit folders (original behavior): each entry points DIRECTLY at one plugin
    //    folder that contains manifest.json + the entry DLL.
    "Paths": [
      "C:\\plugins\\centralnode\\1.0.0",
      "C:\\plugins\\identity\\1.0.0",
      "C:\\plugins\\mode\\1.0.0"
    ],
    // 2) Discovery roots: folder(s) the host SCANS at startup. Drop a new plugin folder
    //    under one of these and it loads on next launch - no code or config edit needed.
    //    Assumed layout under each root:
    //      <root>\<name>\manifest.json            (flat)
    //      <root>\<name>\<version>\manifest.json   (versioned; highest version wins)
    //    (The root below intentionally overlaps the explicit Paths above to show both
    //     modes working together; overlapping folders are de-duplicated automatically.)
    "PluginRoots": [
      "C:\\plugins"
    ],
    "ContinueOnError": true,
    "VerboseLogging": true
  }
}
